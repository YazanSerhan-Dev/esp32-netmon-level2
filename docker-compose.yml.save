services:
  collector:
    build: ./server
    container_name: netmon-collector
    command: ["python", "collector.py"]
    environment:
      MQTT_HOST: host.docker.internal
      MQTT_PORT: "1883"
      MQTT_TOPIC: netmon/esp32-1/metrics
      NETMON_OUT_DIR: /data
    volumes:
      - netmon_data:/data
    extra_hosts:
      - "host.docker.internal:host-gateway"
    restart: unless-stopped

  web:
    build: ./server
    container_name: netmon-web
    command: ["python", "app.py"]
    environment:
      NETMON_OUT_DIR: /data
      HOST: "0.0.0.0"
      PORT: "8080"
    volumes:
      - netmon_data:/data
    ports:
      - "8080:8080"
    depends_on:
      - collector
    restart: unless-stopped


